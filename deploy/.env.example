# ─────────────────────────────────────────────────────────────────────────────
# ModuLab Core — Docker stack  (.env.example)
# Copy to .env and fill in every value before running `docker compose up`.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────────────────────
# The public domain ModuLab is reachable at.
MODULAB_DOMAIN=modulab.example.com

# ── Let's Encrypt / Cloudflare DNS-Challenge ──────────────────────────────────
# Email used for ACME registration (expiry notices).
ACME_EMAIL=admin@example.com
# Cloudflare API token — needs Zone:DNS:Edit permission for MODULAB_DOMAIN's zone.
# Must be exactly 40 characters with no surrounding whitespace.
CF_DNS_API_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=modulab
POSTGRES_USER=modulab
POSTGRES_PASSWORD=

# ── ModuLab Core ──────────────────────────────────────────────────────────────
# Direct Postgres connection.
MODULAB_DB_HOST=postgres
MODULAB_DB_PORT=5432
MODULAB_DB_NAME=modulab
MODULAB_DB_USER=modulab
MODULAB_DB_PASSWORD=     # same value as POSTGRES_PASSWORD

# Valkey / Redis
MODULAB_VALKEY_HOST=valkey
MODULAB_VALKEY_PORT=6379

# Public URL — used for OAuth callbacks, email links, etc.
MODULAB_PUBLIC_BASE_URL=https://modulab.example.com

# Frontend origin — must match the domain browsers use to reach the UI.
MODULAB_FRONTEND_BASE_URL=https://modulab.example.com

# Master key for encrypting secrets at rest — generate with: openssl rand -hex 32
MODULAB_MASTER_KEY=

# Session signing secret — generate with: openssl rand -hex 32
MODULAB_SESSION_SECRET=

# JWT signing secret — generate with: openssl rand -hex 32
MODULAB_JWT_SECRET=

# Encryption key for PII fields (AES-GCM) — must be exactly 32 bytes hex.
# Generate with: openssl rand -hex 32
MODULAB_ENCRYPTION_KEY=

# ── Optional: SearXNG (only needed when --profile search is active) ───────────
# SEARXNG_SECRET_KEY=   # generate with: openssl rand -hex 32
