# ─────────────────────────────────────────────────────────────────────────────
# ModuLab Core — Docker stack  (.env.example)
# Copy to .env and fill in every value before running `docker compose up`.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────────────────────
# The public domain ModuLab is reachable at.
MODULAB_DOMAIN=modulab.example.com

# ── Let's Encrypt / Cloudflare DNS-Challenge ──────────────────────────────────
# Email used for ACME registration (expiry notices).
ACME_EMAIL=admin@example.com
# Cloudflare API token — needs Zone:DNS:Edit permission for MODULAB_DOMAIN's zone.
# Must be exactly 40 characters with no surrounding whitespace.
CF_DNS_API_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=modulab
POSTGRES_USER=modulab
POSTGRES_PASSWORD=

# ── Valkey ────────────────────────────────────────────────────────────────────
# Password for Core's Valkey instance — generate with: openssl rand -hex 32
# Required: the stack refuses to start without it (see docker-compose.yml's
# valkey service).
#
# Not optional hardening. Session keys are named session:<bearer token>, so
# read access to this instance means reading every logged-in user's token
# directly out of the key names — the AES-GCM encryption applied to the
# values does not help against that. Treat this like POSTGRES_PASSWORD.
#
# SearXNG has its own separate, unauthenticated Valkey (searxng-valkey) and
# does NOT use this value.
VALKEY_PASSWORD=

# ── ModuLab Core ──────────────────────────────────────────────────────────────
# Master key for encrypting secrets at rest — generate with: openssl rand -hex 32
MODULAB_MASTER_KEY=

# Encryption key modules use to encrypt their own PII fields (AES-GCM),
# separate from MODULAB_MASTER_KEY. Optional - only needed if an installed
# module encrypts PII. Must be exactly 32 bytes hex.
# Generate with: openssl rand -hex 32
MODULAB_MODULE_PII_KEY=

# ── ModuLab Core: optional overrides ──────────────────────────────────────────
# Only needed if you changed something from this file's defaults. Uncomment
# and edit only the ones you actually want to override - Core falls back to
# the values shown here on its own.
#
# Host:port the System Info page (/admin/system/info) dials to read the live
# TLS certificate's expiry. Defaults to "traefik:443", matching the Traefik
# service name in docker-compose.yml - only change this if you renamed that
# service or run a different reverse proxy in front of Core.
#MODULAB_TLS_CHECK_ADDR=traefik:443
