# Core
MODULAB_MASTER_KEY=                  # REQUIRED - Core refuses to start without it. 64 hex chars (32 bytes); generate with `openssl rand -hex 32`. No database fallback (see spec section 2.4 and config.go's validateMasterKey).
MODULAB_BOOTSTRAP_TOKEN_TTL=24h
MODULAB_PUBLIC_BASE_URL=http://localhost:8080  # externally reachable URL, used as the OIDC redirect_uri base
MODULAB_FRONTEND_BASE_URL=http://localhost:5173  # where the SPA is served from; Vite dev server in local dev, same as MODULAB_PUBLIC_BASE_URL in production
MODULAB_TLS_CHECK_ADDR=traefik:443  # host:port the System Info page dials to read the live TLS cert's expiry; default matches deploy/docker-compose.yml's Traefik service name

# PostgreSQL (via PgBouncer in production)
MODULAB_DB_HOST=localhost
MODULAB_DB_PORT=6432
MODULAB_DB_NAME=modulab
MODULAB_DB_USER=modulab
MODULAB_DB_PASSWORD=

# Valkey
MODULAB_VALKEY_HOST=localhost
MODULAB_VALKEY_PORT=6379

# Deno subprocess (spec section 4.7)
MODULAB_DENO_SOCKET_PATH=/tmp/modulab-deno.sock
MODULAB_DENO_BINARY_PATH=/usr/local/bin/deno
